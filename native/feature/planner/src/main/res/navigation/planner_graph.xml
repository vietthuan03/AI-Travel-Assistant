    app:enterAnim="@animator/travel_fade_enter" app:exitAnim="@animator/travel_fade_exit"
    app:popEnterAnim="@animator/travel_fade_enter" app:popExitAnim="@animator/travel_fade_exit"/>
</fragment>
<fragment android:id="@id/review_fragment" android:name="com.example.travelassistant.feature.planner.ReviewFragment" android:label="@string/plan_trip">
<argument android:name="screenKey" app:argType="string" android:defaultValue="P03"/>
<argument android:name="previewCase" app:argType="string" android:defaultValue=""/>
<argument android:name="previewExpiry" app:argType="long" android:defaultValue="0L"/>
</fragment>
<fragment android:id="@id/progress_fragment" android:name="com.example.travelassistant.feature.planner.ProgressFragment" android:label="@string/progress_title">
<argument android:name="screenKey" app:argType="string" android:defaultValue="P04"/>
<argument android:name="previewCase" app:argType="string" android:defaultValue=""/>
<argument android:name="previewExpiry" app:argType="long" android:defaultValue="0L"/>
</fragment>
<fragment android:id="@id/itinerary_fragment" android:name="com.example.travelassistant.feature.planner.ItineraryFragment" android:label="@string/itinerary_title">
<argument android:name="screenKey" app:argType="string" android:defaultValue="I01"/>
<argument android:name="previewCase" app:argType="string" android:defaultValue=""/>
<argument android:name="previewExpiry" app:argType="long" android:defaultValue="0L"/>
<argument android:name="tripId" app:argType="string" android:defaultValue=""/><argument android:name="selectedVersion" app:argType="integer" android:defaultValue="0"/>
<action android:id="@+id/action_itinerary_to_budget" app:destination="@id/budget_fragment"/>
</fragment>
<fragment android:id="@id/budget_fragment" android:name="com.example.travelassistant.feature.planner.BudgetFragment" android:label="@string/budget_title">
<argument android:name="screenKey" app:argType="string" android:defaultValue="I02"/>
