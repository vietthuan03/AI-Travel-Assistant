<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@id/planner_graph" app:startDestination="@id/where_fragment">
<fragment android:id="@id/where_fragment" android:name="com.example.travelassistant.feature.planner.WhereFragment" android:label="@string/plan_trip">
<argument android:name="screenKey" app:argType="string" android:defaultValue="P01"/>
<argument android:name="previewCase" app:argType="string" android:defaultValue=""/>
<argument android:name="previewExpiry" app:argType="long" android:defaultValue="0L"/>
<action android:id="@+id/action_where_to_travelers" app:destination="@id/travelers_fragment"
    app:enterAnim="@animator/travel_fade_enter" app:exitAnim="@animator/travel_fade_exit"
    app:popEnterAnim="@animator/travel_fade_enter" app:popExitAnim="@animator/travel_fade_exit"/>
</fragment>
<fragment android:id="@id/travelers_fragment" android:name="com.example.travelassistant.feature.planner.TravelersFragment" android:label="@string/plan_trip">
