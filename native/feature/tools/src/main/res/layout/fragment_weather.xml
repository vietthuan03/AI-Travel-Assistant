<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/screen_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_inset">
        <TextView android:id="@+id/preview_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/preview_banner" android:textAppearance="?attr/textAppearanceBodyLarge" android:visibility="gone" android:accessibilityLiveRegion="polite" android:padding="12dp" android:background="@color/travel_accent_soft" />
        <TextView android:id="@+id/weather_city_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/weather_location" android:labelFor="@id/weather_city" android:textAppearance="?attr/textAppearanceLabelLarge" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/weather_city_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:hintEnabled="false">
            <AutoCompleteTextView android:id="@+id/weather_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="text" android:completionThreshold="1" android:maxLength="120" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/weather_selected_place" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:layout_marginBottom="12dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/use_location" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:text="@string/use_location" />
        <TextView android:id="@+id/weather_units_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/units_label" android:labelFor="@id/weather_units" android:textAppearance="?attr/textAppearanceLabelLarge" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/weather_units_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:hintEnabled="false">
            <AutoCompleteTextView android:id="@+id/weather_units" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/search_weather" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:text="@string/search_weather" />
        <TextView android:id="@+id/weather_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/weather_unavailable" android:textAppearance="?attr/textAppearanceBodyLarge" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/weather_progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:indeterminate="true" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/current_conditions" android:textAppearance="?attr/textAppearanceTitleLarge" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_conditions" android:textAppearance="?attr/textAppearanceBodyLarge" android:paddingVertical="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/forecast_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:accessibilityHeading="true" />
        <TextView android:id="@+id/weather_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/source_none" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.button.MaterialButton android:id="@+id/weather_retry" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:text="@string/retry" />
        <com.google.android.material.button.MaterialButton android:id="@+id/permission_settings" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:text="@string/open_android_settings" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
