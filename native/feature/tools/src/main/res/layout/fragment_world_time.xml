<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/screen_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_inset">
        <TextView android:id="@+id/preview_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/preview_banner" android:textAppearance="?attr/textAppearanceBodyLarge" android:visibility="gone" android:accessibilityLiveRegion="polite" android:padding="12dp" android:background="@color/travel_accent_soft" />
        <TextView android:id="@+id/intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/world_time_intro" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView android:id="@+id/local_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/local_time" android:textAppearance="?attr/textAppearanceTitleLarge" android:accessibilityHeading="true" />
        <TextView android:id="@+id/local_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/not_selected" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView android:id="@+id/time_destination_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/destination_zone" android:labelFor="@id/time_destination" android:textAppearance="?attr/textAppearanceLabelLarge" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/time_destination_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:hintEnabled="false">
            <AutoCompleteTextView android:id="@+id/time_destination" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/destination_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/destination_time" android:textAppearance="?attr/textAppearanceTitleLarge" android:accessibilityHeading="true" />
        <TextView android:id="@+id/destination_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/not_selected" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView android:id="@+id/difference" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/not_selected" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView android:id="@+id/clock_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/device_clock_note" android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
