<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/language_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:accessibilityHeading="true" />
        <TextView android:id="@+id/settings_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/preview_banner" android:padding="12dp" android:background="@color/travel_accent_soft" android:visibility="gone" />
        <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/language_english" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/english" android:paddingVertical="12dp" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/language_vietnamese" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/vietnamese" android:paddingVertical="12dp" />
        </RadioGroup>
        <TextView android:id="@+id/language_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:textAppearance="?attr/textAppearanceBodyLarge" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/language_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/retry" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/language_note" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/local_only" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView android:id="@+id/display_currency_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/display_currency" android:labelFor="@id/display_currency" android:textAppearance="?attr/textAppearanceLabelLarge" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/display_currency_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:hintEnabled="false">
            <AutoCompleteTextView android:id="@+id/display_currency" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/temperature_units_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/units_label" android:labelFor="@id/temperature_units" android:textAppearance="?attr/textAppearanceLabelLarge" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/temperature_units_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:hintEnabled="false">
            <AutoCompleteTextView android:id="@+id/temperature_units" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/preferences_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:text="@string/display_preferences_error" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/preferences_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/retry" android:visibility="gone" />
        <TextView android:id="@+id/preferences_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/preferences_note" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.button.MaterialButton android:id="@+id/privacy" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:text="@string/privacy_title" />
        <com.google.android.material.button.MaterialButton android:id="@+id/retention" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:text="@string/retention_title" />
        <com.google.android.material.button.MaterialButton android:id="@+id/help" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:text="@string/help_title" />
        <com.google.android.material.button.MaterialButton android:id="@+id/legal" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:text="@string/legal_title" />
        <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/app_version" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.button.MaterialButton android:id="@+id/preview_gallery" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:text="@string/preview_gallery" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/remove_data" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:minHeight="48dp" android:text="@string/remove_data" />
    </LinearLayout>
</ScrollView>
