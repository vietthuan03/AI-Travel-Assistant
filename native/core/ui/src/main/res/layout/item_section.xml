<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/section_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:clipToOutline="true"
    app:cardBackgroundColor="@color/travel_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/travel_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/illustration"
                android:layout_width="144dp"
                android:layout_height="98dp"
                android:layout_marginBottom="14dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Travel.Illustration" />

            <TextView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/travel_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/travel_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:accessibilityHeading="true"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/travel_text" />

            <TextView
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:lineSpacingExtra="2dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/travel_secondary_text" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/day_choices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:singleLine="false"
                app:singleSelection="true" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:indeterminate="true"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/row_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/row_secondary"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/row_tertiary"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
