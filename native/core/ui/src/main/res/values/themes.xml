<resources>
    <style name="Theme.TravelAssistant" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/travel_primary</item>
        <item name="colorOnPrimary">@color/travel_on_primary</item>
        <item name="colorPrimaryContainer">@color/travel_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/travel_text</item>
        <item name="colorSecondary">@color/travel_primary</item>
        <item name="colorSecondaryContainer">@color/travel_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/travel_text</item>
        <item name="colorSurface">@color/travel_surface</item>
        <item name="colorSurfaceContainerLowest">@color/travel_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/travel_container_low</item>
        <item name="colorSurfaceContainer">@color/travel_container</item>
        <item name="colorSurfaceContainerHigh">@color/travel_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/travel_container_highest</item>
        <item name="colorOnSurface">@color/travel_text</item>
        <item name="colorOnSurfaceVariant">@color/travel_secondary_text</item>
        <item name="colorOutline">@color/travel_control_outline</item>
        <item name="android:colorBackground">@color/travel_background</item>
        <item name="colorError">@color/travel_error</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="materialButtonStyle">@style/Widget.Travel.Button</item>
    </style>

    <style name="Widget.Travel.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="TextAppearance.Travel.Hero" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/travel_text</item>
    </style>

    <style name="ShapeAppearance.Travel.Illustration" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
